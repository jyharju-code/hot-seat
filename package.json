{
  "name": "hot-seat",
  "version": "0.1.0",
  "private": true,
  "description": "Hot Seat: a live crisis rehearsal for small business owners. Built with Meta Muse models.",
  "license": "MIT",
  "type": "module",
  "workspaces": ["server", "web", "shared"],
  "scripts": {
    "dev": "concurrently -n server,web -c blue,red \"npm run dev -w @hot-seat/server\" \"npm run dev -w @hot-seat/web\"",
    "build": "npm run build --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "eslint .",
    "test": "vitest run",
    "check": "npm run typecheck && npm run lint && npm run test",
    "smoke:voice": "npm run smoke:voice -w @hot-seat/server",
    "smoke:scenario": "npm run smoke:scenario -w @hot-seat/server",
    "smoke:latency": "npm run smoke:latency -w @hot-seat/server",
    "smoke:scenario-speed": "npm run smoke:scenario-speed -w @hot-seat/server",
    "smoke:browserlike": "npm run smoke:browserlike -w @hot-seat/server",
    "smoke:debrief": "npm run smoke:debrief -w @hot-seat/server"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "concurrently": "^9.1.2",
    "eslint": "^9.17.0",
    "globals": "^15.14.0",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.19.0",
    "vitest": "^2.1.8"
  },
  "engines": { "node": ">=24" }
}
