# Copy to .env and fill in. Never commit .env.
MODEL_API_KEY=
ELEVENLABS_API_KEY=
SONIOX_API_KEY=
BASETEN_API_KEY=

# Optional overrides. SERVER_PORT (not PORT) so web hosts that set
# PORT for the web process cannot collide with the API server. The
# Vite /api proxy reads the same SERVER_PORT.
# Directory for JSON scenario/session records (default ./data).
# DATA_DIR=./data
SERVER_PORT=3001
SERVER_HOST=127.0.0.1
# LLM_CHAT_MODEL=muse-spark-1.3
# LLM_STRUCTURED_MODEL=muse-wonder-1.0
# Turn LLM provider: meta (default) or baseten.
# TURN_LLM=meta
# Race both turn providers at once when both keys exist: on (default) or off (late hedge).
# TURN_RACE=on
# Partial transcript unchanged for this long starts the speculative turn (ms).
# PARTIAL_STABLE_MS=450
# Scenario generation model and reasoning effort.
# SCENARIO_MODEL=muse-wonder-1.0
# SCENARIO_REASONING=medium
# Silence after the last transcript segment before the owner's turn ends (ms).
TURN_END_SILENCE_MS=1500
# Extended silence when the owner's answer looks unfinished (ms).
# TURN_END_HESITANT_MS=3200
# Listening with no speech at all for this long ends the session (ms).
# LISTEN_IDLE_MS=60000
# Hard cap on one session's length (ms).
# MAX_SESSION_MS=600000
# Reporter interruptions while the owner is speaking: on (default) or off.
# INTERRUPTS=on
